        </section>

        <!-- Contact Section -->
        <section id="contact" class="py-5 bg-body-tertiary">
            <div class="container">
                <h2 class="fw-bold text-center mb-5">Let's build something meaningful</h2>
                <div class="row g-4">
                    <div class="col-lg-4">
                        <div class="card border-0 shadow-sm h-100 p-4">
                            <h4 class="fw-bold mb-3">Get in Touch</h4>
                            <p class="mb-2"><strong>Email:</strong> <a href="mailto:saradoota@gmail.com" class="text-decoration-none">saradoota@gmail.com</a></p>
                            <p class="mb-2"><strong>GitHub:</strong> <a href="https://github.com/Sara4101" target="_blank" class="text-decoration-none">GitHub Profile</a></p>
                            <p class="mb-0"><strong>LinkedIn:</strong> <a href="#" class="text-decoration-none">LinkedIn Profile</a></p>
                        </div>
                    </div>
                    <div class="col-lg-8">
                        <div class="card border-0 shadow-sm p-4">
                            <form id="contactForm" novalidate>
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label for="name" class="form-label">Name</label>
                                        <input type="text" class="form-control" id="name" required>
                                        <div class="text-danger small mt-1 error-msg" id="nameError"></div>
                                    </div>
                                    <div class="col-md-6">
                                        <label for="email" class="form-label">Email</label>
                                        <input type="email" class="form-control" id="email" required>
                                        <div class="text-danger small mt-1 error-msg" id="emailError"></div>
                                    </div>
                                    <div class="col-12">
                                        <label for="subject" class="form-label">Subject</label>
                                        <input type="text" class="form-control" id="subject" required>
                                        <div class="text-danger small mt-1 error-msg" id="subjectError"></div>
                                    </div>
                                    <div class="col-12">
                                        <label for="message" class="form-label">Message</label>
                                        <textarea class="form-control" id="message" rows="4" required></textarea>
                                        <div class="text-danger small mt-1 error-msg" id="messageError"></div>
                                    </div>
                                    <div class="col-12 d-flex justify-content-between align-items-center mt-3">
                                        <button type="submit" class="btn btn-primary px-4">Send Message</button>
                                        <span id="formSuccess" class="text-success fw-bold display-none">Your message has been sent successfully!</span>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </section>
