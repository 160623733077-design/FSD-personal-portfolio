                    <div class="col-lg-4 col-md-6 project-card" data-category="web">
                        <div class="card h-100 border-0 shadow-sm">
                            <div class="card-body">
                                <span class="badge bg-secondary mb-2">Web</span>
                                <h5 class="card-title fw-bold">MovieMatch AI</h5>
                                <p class="card-text text-muted">An AI-driven recommendation platform suggesting tailored film choices based on user preferences.</p>
