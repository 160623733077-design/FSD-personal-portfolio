        <!-- Projects Section -->
        <section id="projects" class="py-5">
            <div class="container">
                <h2 class="fw-bold mb-3">Projects</h2>
                
                <!-- Filter Buttons -->
                <div class="d-flex gap-2 mb-4">
                    <button class="btn btn-primary filter-btn active" data-filter="all">All</button>
                    <button class="btn btn-outline-primary filter-btn" data-filter="web">Web</button>
                    <button class="btn btn-outline-primary filter-btn" data-filter="ui">UI</button>
                    <button class="btn btn-outline-primary filter-btn" data-filter="app">App</button>
                </div>

                <div class="row g-4">
                    <!-- Project 1 -->
                    <div class="col-lg-4 col-md-6 project-card" data-category="app">
                        <div class="card h-100 border-0 shadow-sm">
                            <div class="card-body">
                                <span class="badge bg-secondary mb-2">App</span>
                                <h5 class="card-title fw-bold">Mental Health Prediction</h5>
                                <p class="card-text text-muted">A machine learning approach designed to assess and predict mental health indicators using user data models.</p>
                            </div>
                        </div>
                    </div>
                    <!-- Project 2 -->
                    <div class="col-lg-4 col-md-6 project-card" data-category="app">
                        <div class="card h-100 border-0 shadow-sm">
                            <div class="card-body">
                                <span class="badge bg-secondary mb-2">App</span>
                                <h5 class="card-title fw-bold">Student Stress Guardian</h5>
                                <p class="card-text text-muted">An analytical application monitoring student academic pressure levels and offering stress management insights.</p>
                            </div>
                        </div>
                    </div>
